<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SevenStation.Core</AssemblyName>
    <RootNamespace>SevenStation.Core</RootNamespace>
    <Version>0.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Log.cs" Link="Log.cs" />
    <Compile Include="..\Shared\ProductPaths.cs" Link="ProductPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 装成 Windows 服务跑：没有它就只能当控制台程序。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.4" />
    <!-- 10.0.4 默认带 2.1.11 的 e_sqlite3，有已知漏洞，钉到修好的原生库。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 从 bin 目录直接启动时 content root 就是 exe 所在目录，页面要跟着复制过去。 -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Agents\pi-guidance.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
