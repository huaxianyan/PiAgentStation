{
  "identifier": "center-page",
  "description": "中心页面可以调用壳的命令",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*", "http://*:*/*", "https://*:*/*"]
